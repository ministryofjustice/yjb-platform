  "pages": [
    {
      "file": "home.html",
      "title": "Home",
      "description": "Service start page",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "links": {
        "/calculate": "calculate.html"
      },
      "compareIgnore": [
        "[data-qa=timestamp]"
      ]
    },
    {
      "file": "calculate.html",
      "title": "New calculation",
      "description": "Empty DTO calculation form. Submitting it shows the happy-path results.",
      "request": {
        "method": "GET",
        "path": "/calculate"
      },
      "formAction": "results.html"
    },
    {
      "file": "calculate-invalid.html",
      "title": "New calculation – validation errors",
      "description": "The form after submitting the 'invalid' scenario",
      "request": {
        "method": "POST",
        "path": "/calculate",
        "scenario": "invalid"
      },
      "formAction": "calculate-invalid.html"
    },
    {
      "file": "results.html",
      "title": "Sentence calculation results",
      "description": "Results for the happy-path scenario",
      "request": {
        "method": "POST",
        "path": "/calculate",
        "scenario": "happy-path"
      },
      "links": {
        "/calculate?*": "calculate-edit.html",
        "/calculate": "calculate.html"
      }
    },
    {
      "file": "calculate-edit.html",
      "title": "New calculation – editing answers",
      "description": "The form pre-filled from the results page's Back and Edit links",
      "request": {
        "method": "GET",
        "followLink": {
          "page": "results.html",
          "selector": ".govuk-back-link"
        }
      },
      "formAction": "results.html"
    }
  ],
  "globalLinks": {
    "/": "home.html"
