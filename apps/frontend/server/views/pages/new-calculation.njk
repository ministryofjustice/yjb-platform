{% extends "../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = applicationName + " - New calculation" %}
{% set mainClasses = "govuk-body" %}

{% block content %}

  {% if not (isValid | default(true)) %}
   {{ govukErrorSummary({
    titleText: "There is a problem",
    errorList: errorSummary
  }) }}
  {% endif %}

  <h1>New calculation</h1>
  <p id="instruction-text">Enter the calculation details below</p>

  <h2>Offence and sentence details</h2>

  <form id="calculation-form" action="/calculate" method="post">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-third">
        {{ govukSelect({
          name: "sentence-type",
          label: {
            text: "Sentence type",
            classes: "govuk-fieldset__legend--s"
          },
          items: [
            {
              value: "",
              text: "",
              selected: true,
              disabled: true
            },
            {
              value: "some-sentence-code",
              text: "Some sentence that is applicable to DTO"
            }
          ]
        }) }}

        {% call govukFieldset({
          legend: {
            text: "Length of sentence",
            classes: "govuk-fieldset__legend--s"
          }
        }) %}
          {{ govukInput({
            label: {
              text: "Months"
            },
            classes: "govuk-!-width-one-quarter",
            id: "sentence-length-months",
            name: "sentence-length-months",
            value: formData.sentenceLengthMonths,
            errorMessage: errorsByField['sentence-length-months'] and { text: errorsByField['sentence-length-months'] }
          }) }}
        {% endcall %}
      </div>
      <div class="govuk-grid-column-one-third">
        {% set sentenceDateErrors = [errorsByField['sentence-date-day'], errorsByField['sentence-date-month'], errorsByField['sentence-date-year']] | reject('undefined') | list %}
        {% set sentenceDateError = sentenceDateErrors | join('<br>') %}
        {{ govukDateInput({
          id: 'sentence-date',
          namePrefix: "sentence-date",
          fieldset: {
            legend: {
              text: "Sentence date",
              classes: "govuk-fieldset__legend--s"
            }
          },
          hint: {
            text: "For example, 27 03 2007"
          },
          errorMessage: sentenceDateError and { html: sentenceDateError },
          items: [
            { name: 'day', value: formData.sentenceDateDay, error: errorsByField['sentence-date-day'] or false },
            { name: 'month', value: formData.sentenceDateMonth, error: errorsByField['sentence-date-month'] or false },
            { name: 'year', value: formData.sentenceDateYear, error: errorsByField['sentence-date-year'] or false }
          ]
        }) }}

        {% call govukFieldset({
          legend: {
            text: "Remand periods (days)",
            classes: "govuk-fieldset__legend--s"
          }
        }) %}

          <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
              {{ govukInput({
                label: {
                  text: "Remand"
                },
                id: "remand-days",
                name: "remand-days",
                value: formData.remandDays,
                errorMessage: errorsByField['remand-days'] and { text: errorsByField['remand-days'] }
              }) }}
            </div>

            <div class="govuk-grid-column-one-half">
              {{ govukInput({
                label: {
                  text: "Tagged bail"
                },
                id: "tagged-bail-days",
                name: "tagged-bail-days",
                value: formData.taggedBailDays,
                errorMessage: errorsByField['tagged-bail-days'] and { text: errorsByField['tagged-bail-days'] }
              }) }}
            </div>
          </div>

        {% endcall %}
      </div>
    </div>

    {{ govukButton({
      id: 'calculate-button',
      text: "Calculate"
    }) }}
  </form>

{% endblock %}
