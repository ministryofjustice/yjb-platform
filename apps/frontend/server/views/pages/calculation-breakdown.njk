{% extends "../partials/layout.njk" %}

{% set pageTitle = applicationName + " - Calculation breakdown" %}
{% set mainClasses = "govuk-body" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{% set backHref = "/calculate?remandStartDate=" + (inputData.remandStartDateString or "")
  + "&taggedBailDays=" + inputData.taggedBailDays
  + "&sentenceLengthMonths=" + inputData.sentenceLengthMonths
  + "&sentenceDate=" + inputData.sentenceDateString
%}

{% block content %}

  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}

  <h1 class="govuk-heading-l">Calculation breakdown</h1>

  <div class="govuk-grid-row" hidden>
      {% call govukDetails({
        summaryText: "Debug info"
      }) %}
        <h2>Payload</h2>
        <p>{{ payloadString }}</p>
        <h2>Result json</h2>
        <p>{{ calculationResultString }}</p>
      {% endcall %}
  </div>


  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">

      {{ govukSummaryList({
        card: {
          title: { text: "Your answers" },
          actions: { items: [
            {
              text: "Change answers",
              href: backHref
            }
          ] }
        },
        rows: [
          { key: { text: "Sentence date" }, value: { text: inputData.sentenceDateString } },
          { key: { text: "Sentence length" }, value: { text: inputData.sentenceLengthMonths + " months" } },
          { key: { text: "Remand start date" }, value: { text: inputData.remandStartDateString } },
          { key: { text: "Days spent on tagged bail" }, value: { text: inputData.taggedBailDays } }
        ]
      }) }}
    </div>
  </div>

  {% include "../partials/calculation-breakdown/view-B.njk" %}

{% endblock %}
