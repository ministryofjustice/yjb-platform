{%- from "moj/components/side-navigation/macro.njk" import mojSideNavigation -%}

<div id="view-2" class="govuk-grid-row">
  <div class="govuk-grid-column-one-quarter">
    {{ mojSideNavigation({
      label: "Side navigation",
      items: [
        { text: "Sentence calculation", href: "#calculation-results", active: true },
        { text: "Detailed breakdown", href: "#results-breakdown" }
      ]
    }) }}
  </div>

  <div class="govuk-grid-column-three-quarters">
    <div id="calculation-results" class="js-side-nav-panel">
      <h2>Calculation results</h2>

      {{ govukSummaryList({
            rows: [
              { key: { text: "Term type" }, value: { text: "Detention and Training Order (DTO)" } },
              { key: { text: "Term length" }, value: { text: calculationResult.calculatedTerms[0].inputSentence.durationMonths + " months (" + calculationResult.calculatedTerms[0].totalDaysInTerm + " days)" } },
              { key: { text: "Custodial period" }, value: { text: calculationResult.calculatedTerms[0].totalDaysMTD + " days" } },
              { key: { text: "MTD" }, value: { text: termDates.mtd } },
              { key: { text: "Remand period" }, value: { text: calculationResult.remandPeriodDays + " days" } },
              { key: { text: "SLED" }, value: { text: resultDates.finalSled } },
              { key: { text: "Final MTD" }, value: { text: resultDates.finalMtd } },
              { key: { text: "ETD" }, value: { text: resultDates.etd } },
              { key: { text: "LTD" }, value: { text: resultDates.ltd } }
            ]
          }) }}
    </div>

    <div id="results-breakdown" class="js-side-nav-panel">
      <h2>Results breakdown</h2>

      {{ govukSummaryList({
        rows: [
          { key: { text: "Term type" }, value: { text: "Detention and Training Order (DTO)" } },
          { key: { text: "Term length" }, value: { text: breakdownObj.termLengthBreakdown } },
          { key: { text: "Custodial period" }, value: { text: calculationResult.calculatedTerms[0].totalDaysMTD + " days (" + breakdownObj.custodialPeriodBreakdown + ")" } },
          { key: { text: "MTD" }, value: { text: breakdownObj.mtdBreakdown } },
          { key: { text: "Remand period" }, value: { text: calculationResult.remandPeriodDays + " days " + breakdownObj.remandPeriodBreakdown } },
          { key: { text: "SLED" }, value: { text: breakdownObj.finalSledBreakdown } },
          { key: { text: "Final MTD" }, value: { text: breakdownObj.finalMtdBreakdown } },
          { key: { text: "ETD" }, value: { text: breakdownObj.etdBreakdown } },
          { key: { text: "LTD" }, value: { text: breakdownObj.ltdBreakdown } }
        ]
      }) }}
    </div>

    <div class="govuk-!-padding-top-4">
      <a id="new-calculation-link-b" href="/calculate">Start a new DTO calculation</a>
    </div>
  </div>
</div>
