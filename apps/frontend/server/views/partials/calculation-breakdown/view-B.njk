<div id="view-2" class="govuk-grid-row">

  {% set calculationResultsHtml %}
  <h2>Calculation results</h2>

  {{ govukSummaryList({
        rows: [
          { key: { text: "Term type" }, value: { text: "Detention and Training Order (DTO)" } },
          { key: { text: "Term length" }, value: { text: periods.termLength } },
          { key: { text: "Custodial period" }, value: { text: periods.custodialPeriod } },
          { key: { text: "Remand period" }, value: { text: periods.remandPeriod } },
          { key: { text: "MTD" }, value: { text: termDates.mtd } },
          { key: { text: "SLED" }, value: { text: resultDates.finalSled } },
          { key: { text: "Final MTD" }, value: { text: resultDates.finalMtd } },
          { key: { text: "ETD" }, value: { text: resultDates.etd } },
          { key: { text: "LTD" }, value: { text: resultDates.ltd } }
        ]
      }) }}
  {% endset -%}

  {# shows a breakdown value on two lines#}
  {% macro twoLines(firstLine, secondLine) -%}
    {%- if firstLine %}<span class="govuk-!-display-block">{{ firstLine }}</span>{% endif -%}
    <span class="govuk-!-display-block govuk-!-font-size-16">{{ secondLine }}</span>
  {%- endmacro %}

  {% set resultsBreakdownHtml %}
  <h2>Detailed breakdown</h2>

  {{ govukSummaryList({
    rows: [
      { key: { text: "Term type" }, value: { text: "Detention and Training Order (DTO)" } },
      { key: { text: "Term length" }, value: { html: twoLines(periods.termLength, breakdownObj.termLengthBreakdown) } },
      { key: { text: "Custodial period" }, value: { html: twoLines(periods.custodialPeriod, breakdownObj.custodialPeriodBreakdown) } },
      { key: { text: "Remand period" }, value: { html: twoLines(periods.remandPeriod, breakdownObj.remandPeriodBreakdown) } },
      { key: { text: "MTD" }, value: { html: twoLines(breakdownObj.mtdDate, breakdownObj.mtdBreakdown) } },
      { key: { text: "SLED" }, value: { html: twoLines(breakdownObj.finalSledDate, breakdownObj.finalSledBreakdown) } },
      { key: { text: "Final MTD" }, value: { html: twoLines(breakdownObj.finalMtdDate, breakdownObj.finalMtdBreakdown) } },
      { key: { text: "ETD" }, value: { html: twoLines(breakdownObj.etdDate, breakdownObj.etdBreakdown) } },
      { key: { text: "LTD" }, value: { html: twoLines(breakdownObj.ltdDate, breakdownObj.ltdBreakdown) } }
    ]
  }) }}
  {% endset -%}

  <div class="govuk-grid-column-two-thirds">
    {{ govukTabs({
      items: [
        {
          label: "Calculation results",
          id: "calculation-results-tab",
          panel: {
            html: calculationResultsHtml
          }
        },
        {
          label: "Detailed breakdown",
          id: "results-breakdown-tab",
          panel: {
            html: resultsBreakdownHtml
          }
        }
      ]
    }) }}
  
  </div>


</div>